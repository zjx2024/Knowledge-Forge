export default "#version 300 es\n#ifdef GL_ES\nprecision highp float;\n#endif\n\nin vec4 rgba;\n\nout vec4 fragColor;\n\nvoid main() {\n  // Circular sprite: hover is radius-based, like the rendered point shape.\n  vec2 fromCenter = 2.0 * gl_PointCoord - 1.0;\n  if (dot(fromCenter, fromCenter) > 1.0) discard;\n  fragColor = rgba;\n}\n"