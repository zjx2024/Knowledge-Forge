    "listed_in": {"source_role_pairs":["direct_argument->grammatical_subject"]},
    "located_in": {"source_role_pairs":["action_theme->role_complement","grammatical_subject->role_complement"]},
    "mapped_to": {"source_role_pairs":["action_theme->role_complement"]},
    "part_of": {"source_role_pairs":["action_theme->grammatical_subject","grammatical_subject->direct_argument"]},
    "possesses": {"source_role_pairs":["possessor->possessed"]},
    "provides": {"source_role_pairs":["grammatical_subject->action_theme","grammatical_subject->direct_argument"]},
    "sends": {"source_role_pairs":["grammatical_subject->action_theme"]},
    "submits": {"source_role_pairs":["grammatical_subject->action_theme"]},
    "submitted_to": {"source_role_pairs":["action_theme->role_complement"]},
