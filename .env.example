# Address exposed to browsers and written into source document URLs.
SERVICE_HOST=127.0.0.1
RUNTIME_MODE=development
UPLOAD_HOST=127.0.0.1
UPLOAD_PORT=8011
HTTP_BASE_URL=http://127.0.0.1:8010
ALLOW_UNSAFE_PUBLIC_BIND=false
PUBLIC_BIND_APPROVED=false
AUTHENTICATION_ENABLED=false

# PostgreSQL metadata storage. The application creates the knowledge_forge database
# and tables when the configured user has CREATE DATABASE permission.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<replace-with-a-random-secret-at-least-12-characters>
POSTGRES_DB=knowledge_forge

# Ollama provides discovery, embeddings and structured extraction.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=-1m
OLLAMA_TIMEOUT=480
OLLAMA_EFFECTIVE_CONTEXT_FALLBACK_TOKENS=8192
OLLAMA_DEFAULT_CONTEXT_BUDGET_TOKENS=8192
OLLAMA_DEFAULT_MAX_OUTPUT_TOKENS=2048
OLLAMA_SAFETY_MARGIN_TOKENS=256
OLLAMA_TOKEN_VARIANCE_ABSOLUTE_TOKENS=128
OLLAMA_TOKEN_VARIANCE_RATIO=0.50
OLLAMA_CONTEXT_CACHE_SECONDS=60
OLLAMA_IMAGE_TOKEN_ESTIMATE=1024
DEFAULT_LLM_MODEL=qwen3.6:latest
DEFAULT_EMBEDDING_MODEL=bge-m3:latest
IMAGE_ANALYSIS_ENABLED=true
IMAGE_OCR_ENABLED=true
IMAGE_MIN_WIDTH=96
IMAGE_MIN_HEIGHT=96
IMAGE_MIN_PIXELS=16000
IMAGE_MAX_DIMENSION=2048
IMAGE_SCAN_TEXT_THRESHOLD=40
IMAGE_PDF_RENDER_SCALE=1.7

# Dedicated physical graph. Install deploy/hugegraph/knowledge_forge.properties
# and initialize the HugeGraph store before first use.
HUGEGRAPH_HOST=127.0.0.1
HUGEGRAPH_PORT=8080
HUGEGRAPH_GRAPH=knowledge_forge
HUGEGRAPH_AUTH_ENABLED=false
HUGEGRAPH_USER=
HUGEGRAPH_PASSWORD=
HUGEGRAPH_TIMEOUT=30
HUGEGRAPH_PAGE_SIZE=500
HUGEGRAPH_HUBBLE_URL=http://127.0.0.1:18088
HUGEGRAPH_HUBBLE_GRAPH_HOST=127.0.0.1

CHUNK_MAX_CHARS=2400
CHUNK_OVERLAP_CHARS=160
GENERAL_CHUNK_TARGET_TOKENS=512
GENERAL_CHUNK_MAX_TOKENS=800
GENERAL_CHUNK_OVERLAP_PERCENT=12
PAPER_CHUNK_TARGET_TOKENS=640
PAPER_CHUNK_MAX_TOKENS=900
PAPER_CHUNK_OVERLAP_PERCENT=10
PDF_PROBE_PAGES=5
DOCLING_ENABLED=true
DOCLING_DEVICE=auto
DOCLING_CUDA_FALLBACK=true
DOCLING_GPU_MIN_FREE_MB=6144
DOCLING_GPU_MEMORY_FRACTION=0.20
DOCLING_BATCH_SIZE=1
DOCLING_NUM_THREADS=4
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
UPLOAD_MAX_MB=200
RETRIEVAL_TOP_K=8
RETRIEVAL_DENSE_WEIGHT=0.72
PGVECTOR_CANDIDATE_MULTIPLIER=8
PGVECTOR_MAX_CANDIDATES=200
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64
PGVECTOR_HNSW_EF_SEARCH=100
PGVECTOR_HNSW_MAX_DIMENSIONS=2000
ENTITY_MERGE_THRESHOLD=0.90
ENTITY_LEXICAL_TOP_K=10
ENTITY_VECTOR_TOP_K=20
ENTITY_LEXICAL_MAX_K=50
ENTITY_VECTOR_MAX_K=100
ENTITY_LEXICAL_RECALL_THRESHOLD=0.45
ENTITY_VECTOR_RECALL_THRESHOLD=0.70
ENTITY_LLM_REVIEW_THRESHOLD=0.68
ENTITY_LLM_ACCEPT_THRESHOLD=0.85
ENTITY_LLM_MAX_CANDIDATES=5
ENTITY_LLM_REVIEW_ENABLED=true
ENTITY_AUTO_MERGE_LEXICAL_THRESHOLD=0.96
ENTITY_AUTO_MERGE_VECTOR_THRESHOLD=0.82
ENTITY_RERANKER_ENABLED=true
ENTITY_RERANKER_HOST_PATH=/home/kdfy/models/bge-reranker-v2-m3
ENTITY_RERANKER_MODEL_PATH=/home/kdfy/models/bge-reranker-v2-m3
ENTITY_RERANKER_DEVICE=auto
ENTITY_RERANKER_BATCH_SIZE=4
ENTITY_RERANKER_MAX_LENGTH=384
ENTITY_RERANKER_TOP_K=10
ENTITY_RERANKER_MAX_K=30
ENTITY_RERANKER_GPU_MIN_FREE_MB=4096
ENTITY_RERANKER_REVIEW_THRESHOLD=0.55
ENTITY_RERANKER_AUTO_THRESHOLD=0.93
SCHEMA_AUTO_APPLY=true
SCHEMA_SAMPLE_BASE_CHUNKS=12
SCHEMA_SAMPLE_CEILING_CHUNKS=48
SCHEMA_SAMPLE_BASE_CHARS=12000
SCHEMA_SAMPLE_CEILING_CHARS=60000
SCHEMA_SAMPLE_CHARS_PER_CHUNK=2400
SCHEMA_SAMPLE_MIN_CHARS=160
SCHEMA_SAMPLE_PER_SECTION=2
SCHEMA_REVIEW_BATCH_SIZE=4
SCHEMA_REVIEW_MIN_CONFIDENCE=0.85
SCHEMA_REVIEW_SINGLE_EVIDENCE_CONFIDENCE=0.96
SCHEMA_REVIEW_MIN_EVIDENCE=2
SCHEMA_REVIEW_NOVELTY_THRESHOLD=0.22
SCHEMA_MAX_ENTITY_ADDITIONS=5
SCHEMA_MAX_RELATION_ADDITIONS=8
EXTRACTION_GLEANING_ENABLED=true
EXTRACTION_VERIFICATION_ENABLED=true
EXTRACTION_RULE_ACCEPT_CONFIDENCE=0.78
EXTRACTION_MIN_RELATION_CONFIDENCE=0.55
RELATION_SHADOW_ENABLED=false
RELATION_CLASSIFIER_OUTPUT_RESERVE=2048
RELATION_CLASSIFIER_SAFETY_MARGIN=512
RELATION_CLASSIFIER_MAX_CANDIDATES=8
RELATION_PROPOSER_FAILURE_CIRCUIT_BREAKER=2
RELATION_CLASSIFIER_GLEANING_WINDOW=2
EXTRACTION_GLEANING_INFORMATION_SCORE=0.35
AUDIT_REDACTION_ENABLED=true
AUDIT_RETENTION_DAYS=90
AUDIT_MAX_ROWS=100000
AUDIT_CLEANUP_ENABLED=true
