ENTITY_RERANKER_AUTO_THRESHOLD=0.93
RERANKER_HOST=127.0.0.1
RERANKER_PORT=8012
RERANKER_MODEL_NAME=bge-reranker-v2-m3
RERANKER_API_KEY=
RERANKER_ALLOW_UNAUTHENTICATED_LAN=false
