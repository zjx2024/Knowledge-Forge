# Address exposed to browsers and written into source document URLs.
SERVICE_HOST=127.0.0.1
RUNTIME_MODE=development
UPLOAD_HOST=127.0.0.1
UPLOAD_PORT=8011
HTTP_BASE_URL=http://127.0.0.1:8010
ALLOW_UNSAFE_PUBLIC_BIND=false
PUBLIC_BIND_APPROVED=false
AUTHENTICATION_ENABLED=false

# PostgreSQL metadata storage. The application creates the knowledge_forge database
# and tables when the configured user has CREATE DATABASE permission.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<replace-with-a-random-secret-at-least-12-characters>
POSTGRES_DB=knowledge_forge

# Ollama provides discovery, embeddings and structured extraction. The
# embedding endpoint defaults to OLLAMA_BASE_URL when omitted.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:11434
# For a machine without a local model runtime, change the providers above to
# openai_compatible and fill these standard /v1 endpoints. Keep model names
# identical to the names exposed by the remote provider.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_MODELS=
LLM_API_CONTEXT_TOKENS=32768
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODELS=
EMBEDDING_API_CONTEXT_TOKENS=8192
# Stable numerical-backend identity. Bump it when the endpoint's device or
# implementation changes; parser and chunk results can then remain reusable.
OLLAMA_EMBEDDING_RUNTIME_PROFILE=ollama-local-default-v1
OLLAMA_KEEP_ALIVE=-1m
OLLAMA_TIMEOUT=480
# Fixed generation seed makes model-backed extraction repeatable across retries.
OLLAMA_SEED=17
OLLAMA_EFFECTIVE_CONTEXT_FALLBACK_TOKENS=8192
OLLAMA_DEFAULT_CONTEXT_BUDGET_TOKENS=8192
OLLAMA_DEFAULT_MAX_OUTPUT_TOKENS=2048
OLLAMA_SAFETY_MARGIN_TOKENS=256
OLLAMA_TOKEN_VARIANCE_ABSOLUTE_TOKENS=128
OLLAMA_TOKEN_VARIANCE_RATIO=0.50
OLLAMA_CONTEXT_CACHE_SECONDS=60
OLLAMA_IMAGE_TOKEN_ESTIMATE=1024
DEFAULT_LLM_MODEL=qwen3.8:27b
DEFAULT_EMBEDDING_MODEL=bge-m3:latest
GRAPHRAG_NATIVE_TIMEOUT_SECONDS=7200
IMAGE_ANALYSIS_ENABLED=true
IMAGE_OCR_ENABLED=true
IMAGE_MIN_WIDTH=96
IMAGE_MIN_HEIGHT=96
IMAGE_MIN_PIXELS=16000
IMAGE_MAX_DIMENSION=2048
IMAGE_SCAN_TEXT_THRESHOLD=40
IMAGE_PDF_RENDER_SCALE=1.7

# Dedicated physical graph. Install deploy/hugegraph/knowledge_forge.properties
# and initialize the HugeGraph store before first use.
HUGEGRAPH_HOST=127.0.0.1
HUGEGRAPH_PORT=8080
HUGEGRAPH_GRAPH=knowledge_forge
HUGEGRAPH_AUTH_ENABLED=false
HUGEGRAPH_USER=
HUGEGRAPH_PASSWORD=
HUGEGRAPH_TIMEOUT=30
HUGEGRAPH_PAGE_SIZE=500
HUGEGRAPH_HUBBLE_URL=http://127.0.0.1:18088
HUGEGRAPH_HUBBLE_GRAPH_HOST=127.0.0.1

CHUNK_MAX_CHARS=2400
CHUNK_OVERLAP_CHARS=160
GENERAL_CHUNK_TARGET_TOKENS=512
GENERAL_CHUNK_MAX_TOKENS=800
GENERAL_CHUNK_OVERLAP_PERCENT=12
GENERAL_COALESCE_MIN_SECTIONS=24
PAPER_CHUNK_TARGET_TOKENS=640
PAPER_CHUNK_MAX_TOKENS=900
PAPER_CHUNK_OVERLAP_PERCENT=10
PDF_PROBE_PAGES=5
DOCLING_ENABLED=true
DOCLING_DEVICE=auto
DOCLING_CUDA_FALLBACK=true
DOCLING_GPU_MIN_FREE_MB=6144
DOCLING_GPU_MEMORY_FRACTION=0.20
DOCLING_BATCH_SIZE=1
DOCLING_NUM_THREADS=4
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
UPLOAD_MAX_MB=200
RETRIEVAL_TOP_K=8
RETRIEVAL_DENSE_WEIGHT=0.72
KF_COMMUNITY_REPORTS_ENABLED=true
