[Unit]
Description=Knowledge Forge development web service
Wants=knowledge-forge-reranker.service
After=default.target knowledge-forge-reranker.service

[Service]
Type=simple
WorkingDirectory=%h/zjx-projects/knowledge-forge
ExecStart=%h/zjx-projects/knowledge-forge/.venv/bin/python %h/zjx-projects/knowledge-forge/server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:%h/zjx-projects/knowledge-forge/.codex/work/knowledge-forge-systemd.log
StandardError=append:%h/zjx-projects/knowledge-forge/.codex/work/knowledge-forge-systemd.log

[Install]
WantedBy=default.target
